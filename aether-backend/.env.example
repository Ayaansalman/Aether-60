MONGODB_URI=mongodb://localhost:27017
DB_NAME=aether_db
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# LLM Provider Configuration
# Supported options: mock | openai_compat (default: mock)
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=your-api-key-here
MODEL_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Example: Google Gemini (OpenAI-compatible endpoint)
# MODEL_PROVIDER=openai_compat
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-1.5-flash
# MODEL_API_KEY=your-gemini-api-key

# Example: Tokenra (OpenAI-compatible endpoint)
# MODEL_PROVIDER=openai_compat
# MODEL_BASE_URL=https://tokenra.io/v1
# MODEL_NAME=stealth/ox-alpha
# MODEL_API_KEY=your-tokenra-api-key
